+	// Metal doesn't support triangle fans. Without tessellation, draw the fan as a triangle list built
+	// CPU-side. Otherwise encode it as triangles via an indexed indirect triangles command instead.
 	if (pipeline->getVkPrimitiveTopology() == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN) {
-		encodeIndexedIndirect(cmdEncoder);
+		if (pipeline->isTessellationPipeline()) {
+			encodeIndexedIndirect(cmdEncoder);
+		} else {
