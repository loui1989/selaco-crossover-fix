+// Draws a non-tessellated triangle fan as an indexed triangle list whose indexes are written CPU-side.
+// The indexed indirect path sizes its index buffer for the largest possible draw and runs a compute
+// pass that restarts the Metal render pass, on every draw. Engines that draw many small fans,
+// such as GZDoom walls, become GPU-bound on that overhead alone.
+void MVKCmdDraw::encodeTriangleFanDirect(MVKCommandEncoder* cmdEncoder) {
+
+	if (_vertexCount < 3) { return; }	// No complete triangle to draw.
+
+	auto* pipeline = cmdEncoder->getGraphicsPipeline();
+	auto& mtlFeats = cmdEncoder->getMetalFeatures();
+
+	// Fan triangle t is (v[t+1], v[t+2], v[0]), which keeps the Vulkan provoking vertex first,
+	// matching the order MoltenVK's own fan conversion shader produces.
+	uint32_t triCount = _vertexCount - 2;
+	uint32_t idxCount = triCount * 3;
+	auto* idxBuff = cmdEncoder->getTempMTLBuffer(idxCount * sizeof(uint32_t));
+	auto* pIdx = (uint32_t*)idxBuff->getContents();
+	for (uint32_t t = 0; t < triCount; t++) {
+		pIdx[(t * 3) + 0] = _firstVertex + t + 1;
+		pIdx[(t * 3) + 1] = _firstVertex + t + 2;
+		pIdx[(t * 3) + 2] = _firstVertex;
+	}
+
+	cmdEncoder->_isIndexedDraw = true;
+
+	const MVKMTLBufferAllocation* tempDrawIDBuff = nullptr;
+	if (pipeline->needsDrawIdBuffer()) {
+		tempDrawIDBuff = cmdEncoder->getTempMTLBuffer(sizeof(uint32_t));
+		*(uint32_t*)tempDrawIDBuff->getContents() = 0;	// Non-indirect draws are a single draw.
+	}
+
+	MVKPiplineStages stages;
+	pipeline->getStages(stages);
+	for (uint32_t s : stages) {
+		auto stage = MVKGraphicsStage(s);
+		cmdEncoder->finalizeDrawState(stage);	// Ensure all updated state has been submitted to Metal
+
+		if ( !pipeline->hasValidMTLPipelineStates() ) { return; }	// Abort if this pipeline stage could not be compiled.
+		if (stage != kMVKGraphicsStageRasterization) { continue; }
+
+		MVKRenderSubpass* subpass = cmdEncoder->getSubpass();
+		uint32_t viewCount = subpass->isMultiview() ? subpass->getViewCountInMetalPass(cmdEncoder->getMultiviewPassIndex()) : 1;
+		uint32_t instanceCount = _instanceCount * viewCount;
+		cmdEncoder->getState().offsetZeroDivisorVertexBuffers(*cmdEncoder, stage, pipeline, _firstInstance);
+		if (tempDrawIDBuff) {
+			[cmdEncoder->_mtlRenderEncoder setVertexBuffer: tempDrawIDBuff->_mtlBuffer
+													offset: tempDrawIDBuff->_offset
+												   atIndex: pipeline->getImplicitBuffers(kMVKShaderStageVertex).ids[MVKImplicitBuffer::DrawId]];
+		}
+		if (mtlFeats.baseVertexInstanceDrawing) {
+			[cmdEncoder->_mtlRenderEncoder drawIndexedPrimitives: MTLPrimitiveTypeTriangle
+													  indexCount: idxCount
+													   indexType: MTLIndexTypeUInt32
+													 indexBuffer: idxBuff->_mtlBuffer
+											   indexBufferOffset: idxBuff->_offset
+												   instanceCount: instanceCount
+													  baseVertex: 0
+													baseInstance: _firstInstance];
+		} else {
+			[cmdEncoder->_mtlRenderEncoder drawIndexedPrimitives: MTLPrimitiveTypeTriangle
+													  indexCount: idxCount
+													   indexType: MTLIndexTypeUInt32
+													 indexBuffer: idxBuff->_mtlBuffer
+											   indexBufferOffset: idxBuff->_offset
+												   instanceCount: instanceCount];
+		}
+	}
+}
